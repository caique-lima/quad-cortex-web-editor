{
  "name": "quad-cortex-web-editor",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gen": "npm run gen -w @qc/protocol",
    "test": "vitest run",
    "typecheck": "tsc -p packages/protocol && tsc -p packages/domain && tsc -p packages/transport-webhid && tsc -p apps/web",
    "dev": "npm run dev -w @qc/web",
    "build": "npm run build -w @qc/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/w3c-web-hid": "^1.0.7",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
